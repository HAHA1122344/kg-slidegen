    {
      "id": "C1001",
      "type": "Concept",
      "name": "队列",
      "definition": "只允许在一端插入、另一端删除的线性表，遵循先进先出（FIFO）原则",
      "importance": "掌握",
      "aliases": [
        "队列",
        "FIFO",
        "先进先出"
      ]
    },
    {
      "id": "C1002",
      "type": "Concept",
      "name": "队头与队尾",
      "definition": "允许删除的一端称队头（front），允许插入的一端称队尾（rear）",
      "importance": "掌握",
      "aliases": [
        "队头",
        "队尾",
        "front",
        "rear",
        "队首"
      ]
    },
    {
      "id": "C1003",
      "type": "Concept",
      "name": "顺序队列",
      "definition": "用一段连续存储单元存放队列元素，并用 front、rear 两个指针指示队头与队尾位置",
      "importance": "掌握",
      "complexity": "入队 O(1)，出队 O(1)",
      "aliases": [
        "顺序队列",
        "顺序存储",
        "数组实现"
      ]
    },
    {
      "id": "C1004",
      "type": "Concept",
      "name": "假溢出",
      "definition": "顺序队列中 rear 已到达数组末端但数组前端仍有空闲单元，导致无法继续入队的现象",
      "importance": "熟练",
      "note": "顺序队列的核心缺陷，是引入循环队列的直接动因",
      "aliases": [
        "假溢出",
        "假满",
        "伪溢出"
      ]
    },
    {
      "id": "C1005",
      "type": "Concept",
      "name": "入队与出队操作",
      "definition": "入队在队尾追加元素并后移 rear，出队取走队头元素并后移 front；两者均需先判断队满或队空",
      "importance": "熟练",
      "pseudocode": "def enqueue(q, x):\n    if is_full(q): raise OverflowError\n    q.data[q.rear] = x\n    q.rear += 1\n\ndef dequeue(q):\n    if is_empty(q): raise IndexError\n    x = q.data[q.front]\n    q.front += 1\n    return x",
      "aliases": [
        "入队",
        "出队",
        "enqueue",
        "dequeue",
        "入队与出队",
        "进队"
      ]
    },
    {
      "id": "C1101",
      "type": "Concept",
      "name": "循环队列",
      "definition": "把顺序队列的存储空间首尾相连，用取模运算让 rear 和 front 在到达末端后回到起点，从而复用空闲单元",
      "importance": "掌握",
      "complexity": "入队 O(1)，出队 O(1)",
      "aliases": [
        "循环队列",
        "环形队列",
        "循环队"
      ]
    },
    {
      "id": "C1102",
      "type": "Concept",
      "name": "取模运算",
      "definition": "指针前移时使用 (index + 1) % maxsize，使下标在 [0, maxsize-1] 内循环，是循环队列实现的关键",
      "importance": "掌握",
      "pseudocode": "rear = (rear + 1) % maxsize\nfront = (front + 1) % maxsize",
      "aliases": [
        "取模",
        "模运算",
        "% maxsize",
        "%maxsize"
      ]
    },
    {
      "id": "C1103",
      "type": "Concept",
      "name": "队空条件",
      "definition": "循环队列中 front == rear 表示队列为空",
      "importance": "熟练",
      "aliases": [
        "队空",
        "空队列",
        "判空"
      ]
    },
    {
      "id": "C1104",
      "type": "Concept",
      "name": "队满条件",
      "definition": "为区分队空与队满，通常牺牲一个存储单元，队列满的条件是 (rear + 1) % maxsize == front",
      "importance": "熟练",
      "note": "与队空条件的区别是本讲次最大的易错点",
      "aliases": [
        "队满",
        "满队列",
        "判满"
      ]
    },
    {
      "id": "C1105",
      "type": "Concept",
      "name": "队列长度计算",
      "definition": "循环队列元素个数为 (rear - front + maxsize) % maxsize",
      "importance": "掌握",
      "complexity": "O(1)",
      "aliases": [
        "队列长度",
        "元素个数",
        "长度计算"
      ]
    },
    {
      "id": "C1106",
      "type": "Concept",
      "name": "循环队列的实现",
      "definition": "用 Python 列表模拟定长数组，维护 front、rear、maxsize 三个状态，所有指针移动均需取模",
      "importance": "熟练",
      "pseudocode": "class CircularQueue:\n    def __init__(self, maxsize):\n        self.data = [None] * maxsize\n        self.maxsize = maxsize\n        self.front = 0\n        self.rear = 0\n\n    def is_empty(self):\n        return self.front == self.rear\n\n    def is_full(self):\n        return (self.rear + 1) % self.maxsize == self.front\n\n    def enqueue(self, x):\n        if self.is_full():\n            raise OverflowError('queue is full')\n        self.data[self.rear] = x\n        self.rear = (self.rear + 1) % self.maxsize\n\n    def dequeue(self):\n        if self.is_empty():\n            raise IndexError('queue is empty')\n        x = self.data[self.front]\n        self.front = (self.front + 1) % self.maxsize\n        return x\n\n    def __len__(self):\n        return (self.rear - self.front + self.maxsize) % self.maxsize",
      "aliases": [
        "循环队列的实现",
        "循环队列实现",
        "circular queue"
      ]
    },
    {
      "id": "C1201",
      "type": "Concept",
      "name": "链队列",
      "definition": "用带头结点的单链表实现队列，队头在链表头部出队，队尾在链表尾部入队",
      "importance": "掌握",
      "complexity": "入队 O(1)，出队 O(1)",
      "aliases": [
        "链队列",
        "链表实现队列",
        "linked queue"
      ]
    },
