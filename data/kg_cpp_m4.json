      "id": "U42",
      "type": "Unit",
      "name": "数组作函数参数与排序查找",
      "order": 6,
      "hours": 4,
      "slide_budget": 6,
      "objective": "能解释数组名作函数参数时的地址传递，写出冒泡排序并在有序数组上实现二分查找",
      "forbidden_terms": [
        "递归",
        "快速排序",
        "归并排序",
