# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# virtual environments
.venv/
venv/
env/

# secrets and local configuration
.env
config/local.yaml

# Generated artefacts: the decks themselves are not tracked, but the result
# tables are kept so the experiments can be reproduced.
# ``!outputs/**/`` is required: when a parent directory is ignored, git never
# descends into it to look for the exceptions below.
outputs/**
!outputs/**/
!outputs/.gitkeep
!outputs/*/results.csv
!outputs/*/results.md

# OS files
.DS_Store
Thumbs.db

# editors
.idea/
.vscode/

# Submission archive: built by paper/make_deposit.py, not tracked. The checksum
# manifest is tracked because the Data-availability section points at it.
paper/deposit/*
!paper/deposit/SHA256SUMS

# Internal review and revision notes: working documents, not published with the code
paper/KBS-预评审-20261102.md
paper/revision-notes.md

# pytest temporary directories
.pytest_tmp/

# Blind coding packet: generated on demand by make_packet.py, not shipped in git
paper/independent_coding/packet/

# arXiv submission package: built by paper/make_arxiv.py from the same source as
# the journal build. The staged tree and the archive are regenerated, not tracked;
# the script and the metadata sheet are, so the package is one command away.
paper/arxiv/build/
paper/arxiv/*.zip
paper/arxiv/*.pdf

# Upload staging area: rebuilt by paper/latex/build.sh from the same sources.
paper/submission/
