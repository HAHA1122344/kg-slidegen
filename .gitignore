# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 虚拟环境
.venv/
venv/
env/

# 密钥与本机配置
.env
config/local.yaml

# 生成产物：课件本身不入库，但实验结果（表格）要留档以便复现。
# ``!outputs/**/`` 是必需的：父目录被忽略时，git 不会进去找后面的例外。
outputs/**
!outputs/**/
!outputs/.gitkeep
!outputs/*/results.csv
!outputs/*/results.md

# 系统文件
.DS_Store
Thumbs.db

# 编辑器
.idea/
.vscode/

# 投稿用归档：由 paper/make_deposit.py 生成，正文随 Zenodo 发布，不入库
paper/deposit/

# 内部评审与改稿记录：工作文档，不随代码发表
paper/KBS-预评审-20261102.md
paper/revision-notes.md

# 测试临时目录
.pytest_tmp/
