# Copy to .env, fill in, and never commit the result
# Primary backbone: DeepSeek (main experiment, ablations, style checks)
DEEPSEEK_API_KEY=sk-your-key-here
# Second backbone: Moonshot / Kimi (cross-model replication only; needed for --provider kimi)
MOONSHOT_API_KEY=sk-your-key-here
# Third endpoint: Agnes (the second course and the separation run; needed for --provider agnes)
AGNES_API_KEY=sk-your-key-here
